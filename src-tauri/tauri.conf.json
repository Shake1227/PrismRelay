{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Relay",
  "version": "1.0.3",
  "identifier": "io.github.shake1227.prismrelay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "Prism Relay", "width": 1180, "height": 800, "minWidth": 900, "minHeight": 640, "decorations": true}],
    "security": {"csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share only the game settings you choose",
    "longDescription": "An unofficial local settings sharing utility for Lunar Client and Minecraft.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "publisher": "Shake_1227",
    "resources": {"../LICENSE": "LICENSE", "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"},
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "11.0", "infoPlist": "Info.plist"},
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": false},
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Japanese", "Korean", "SimpChinese", "Finnish", "Spanish", "German"]
      }
    }
  }
}
